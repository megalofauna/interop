{
	"name": "interop",
	"version": "0.1.0",
	"private": true,
	"description": "Angular library for interoperable components and data patterns",
	"keywords": [
		"angular",
		"interop",
		"library",
		"components",
		"typescript"
	],
	"author": "Christopher Salmon",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/christophersalmon/interop.git"
	},
	"scripts": {
		"build:lib": "ng build interop",
		"build:demo": "ng build demo",
		"test": "ng test interop",
		"test:pages": "node scripts/cdp/check-pages.mjs",
		"test:browser": "node scripts/browser/run-checks.mjs",
		"publish:npm": "npm publish dist/interop/",
		"demo": "ng serve demo --open",
		"lint:tokens": "node scripts/check-private-tokens.mjs projects/interop && node scripts/check-keywords.mjs projects/interop && node scripts/check-undefined-tokens.mjs projects/interop projects/demo/src",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint:css": "stylelint \"projects/interop/**/*.css\"",
		"lint": "npm run format:check && npm run lint:css && npm run lint:tokens",
		"test:demo": "ng test demo"
	},
	"devDependencies": {
		"@angular/build": "^21.2.20",
		"@angular/cli": "^21.2.20",
		"@angular/common": "^21.2.20",
		"@angular/compiler": "^21.2.20",
		"@angular/compiler-cli": "^21.2.20",
		"@angular/core": "^21.2.20",
		"@angular/forms": "^21.2.20",
		"@angular/platform-browser": "^21.2.20",
		"@angular/platform-server": "^21.2.25",
		"@angular/router": "^21.2.20",
		"@emnapi/core": "^1.11.3",
		"@emnapi/runtime": "^1.11.3",
		"@tabler/icons": "^3.49.0",
		"@types/node": "^24.0.0",
		"axe-core": "^4.14.0",
		"esbuild": "^0.28.1",
		"jsdom": "^28.0.0",
		"marked": "^18.0.5",
		"ng-packagr": "^21.0.0",
		"playwright": "~1.64.1",
		"prettier": "3.9.6",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"rxjs": "^7.8.0",
		"shiki": "^4.0.2",
		"stylelint": "^17.14.1",
		"typescript": "^5.2.0",
		"vitest": "^4.0.8"
	},
	"dependencies": {
		"tslib": "^2.3.0"
	}
}
