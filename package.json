{
	"name": "interop",
	"version": "0.1.0",
	"private": true,
	"description": "Angular library for interoperable components and data patterns",
	"keywords": [
		"angular",
		"interop",
		"library",
		"components",
		"typescript"
	],
	"author": "Christopher Salmon",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/christophersalmon/interop.git"
	},
	"scripts": {
		"build:lib": "ng build interop",
		"build:demo": "ng build demo",
		"build:protocol": "ng build protocol",
		"build:icons": "node scripts/generate-icons.mjs",
		"build:content": "tsx tools/djot-build.ts projects/demo/src",
		"build:content:watch": "tsx tools/djot-build.ts --watch projects/demo/src",
		"test": "ng test interop",
		"lint:boundaries": "node scripts/check-boundaries.mjs",
		"publish:npm": "npm publish dist/interop/",
		"serve": "ng serve demo",
		"start": "ng serve demo",
		"demo": "ng serve demo --open",
		"protocol": "ng serve protocol --open",
		"lint:tokens": "node scripts/check-private-tokens.mjs && node scripts/check-color-axes.mjs && node scripts/check-focus.mjs && node scripts/check-motion.mjs && node scripts/check-motion.mjs projects/demo/src && node scripts/check-shape.mjs && node scripts/check-keywords.mjs && node scripts/check-undefined-tokens.mjs && node scripts/generate-starter.mjs --check && node scripts/generate-token-reference.mjs --check && node scripts/check-boundaries.mjs",
		"lint:focus": "node scripts/check-focus.mjs",
		"lint:color": "node scripts/check-color-axes.mjs",
		"build:color": "node scripts/generate-color-ladder.mjs",
		"check:color": "node scripts/generate-color-ladder.mjs --check && node scripts/check-contrast-render.mjs",
		"check:render": "node scripts/check-contrast-render.mjs",
		"gen:starter": "node scripts/generate-starter.mjs",
		"gen:tokens": "node scripts/generate-token-reference.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint:css": "stylelint \"projects/interop/src/**/*.{css,scss}\"",
		"lint": "npm run format:check && npm run lint:css && npm run lint:tokens"
	},
	"devDependencies": {
		"@angular/build": "^21.2.20",
		"@angular/cli": "^21.2.20",
		"@angular/common": "^21.2.20",
		"@angular/compiler": "^21.2.20",
		"@angular/compiler-cli": "^21.2.20",
		"@angular/core": "^21.2.20",
		"@angular/forms": "^21.2.20",
		"@angular/platform-browser": "^21.2.20",
		"@angular/platform-browser-dynamic": "^21.2.20",
		"@angular/router": "^21.2.20",
		"@djot/djot": "^0.3.2",
		"@floating-ui/dom": "^1.6.0",
		"@material-symbols/svg-400": "^0.45.10",
		"@types/jasmine": "^5.1.0",
		"@types/node": "^20.0.0",
		"jasmine-core": "^5.1.0",
		"karma": "^6.4.0",
		"karma-chrome-launcher": "^3.2.0",
		"karma-coverage": "^2.2.0",
		"karma-jasmine": "^5.1.0",
		"karma-jasmine-html-reporter": "^2.1.0",
		"marked": "^18.0.5",
		"ng-packagr": "^21.0.0",
		"postcss-scss": "^4.0.9",
		"prettier": "3.9.6",
		"rxjs": "^7.8.0",
		"shiki": "^4.0.2",
		"stylelint": "^17.14.1",
		"tsx": "^4.21.0",
		"typescript": "^5.2.0",
		"zone.js": "^0.15.0"
	}
}
