/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"outDir": "../../out-tsc/app",
		"types": [],
		"baseUrl": "../../",
		"paths": {
			"interop": ["projects/interop_deprecated/src/public-api"],
			"interop/highlighters/shiki": [
				"projects/interop_deprecated/highlighters/shiki/src/public-api.ts"
			],
			"interop/*": ["projects/interop_deprecated/src/*"]
		}
	},
	"include": [
		"src/**/*.ts",
		"../../projects/interop_deprecated/src/lib/**/*.ts",
		"../../projects/interop_deprecated/src/types/**/*.ts",
		"../../projects/interop_deprecated/highlighters/**/*.ts"
	],
	"exclude": [
		"src/**/*.spec.ts",
		"../../projects/interop_deprecated/src/**/*.spec.ts",
		"../../projects/interop_deprecated/src/examples/**/*"
	],
	"angularCompilerOptions": {
		"compilationMode": "full"
	}
}
