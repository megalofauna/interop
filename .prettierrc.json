{
	"useTabs": true,
	"overrides": [
		{
			"files": ["projects/**/*.html"],
			"options": {
				"parser": "angular"
			}
		},
		{
			"files": ["projects/interop/**/*.ts"],
			"options": {
				"singleQuote": true,
				"printWidth": 140
			}
		},
		{
			"files": ["projects/interop/**/*.css"],
			"options": {
				"printWidth": 140
			}
		}
	]
}
